{
  "name": "@thainaute/content",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./fixture": "./src/fixture.ts",
    "./language-packs": "./src/language-packs.ts",
    "./mobile": "./src/mobile.ts",
    "./preview": "./src/preview-contracts.ts",
    "./public": "./src/public-contracts.ts",
    "./schemas": "./src/schemas.ts",
    "./studio": "./src/studio.ts"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "content:validate": "tsx src/cli.ts validate",
    "content:audit": "tsx src/cli.ts audit",
    "content:compile": "tsx scripts/compile-items.ts",
    "content:compile-lesson": "tsx scripts/compile-lesson.ts",
    "content:compile-text": "tsx scripts/compile-text-lessons.ts",
    "content:catalog": "tsx scripts/generate-authoring-catalog.ts && tsx scripts/generate-authoring-module.ts",
    "content:authoring-module": "tsx scripts/generate-authoring-module.ts",
    "content:authoring-drafts": "tsx scripts/generate-authoring-drafts.ts",
    "content:audio": "tsx scripts/generate-audio.ts",
    "content:verify": "tsx scripts/verify-bundle.ts"
  },
  "dependencies": {
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "tsx": "4.23.1",
    "typescript": "6.0.3",
    "vitest": "4.1.10"
  }
}
