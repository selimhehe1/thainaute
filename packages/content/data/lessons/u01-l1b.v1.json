  "teaching": [
    {
      "ordre": 1,
      "titleFr": "une durée qui change le sens",
      "bodyFr": "En français, étirer une voyelle ne change jamais le mot : « biiien » reste « bien », en plus insistant. En thaï, la durée fait partie du mot : une voyelle courte et la même voyelle longue donnent deux mots différents. Votre oreille ne surveille pas encore cette durée, c'est normal ; cette leçon lui apprend à le faire.",
      "specimen": "เข้า ≠ ข้าว"
    },
    {
      "ordre": 2,
      "titleFr": "comment Thaïnaute vous montre la durée",
