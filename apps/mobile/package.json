{
  "name": "@thainaute/mobile",
  "version": "0.0.0",
  "private": true,
  "main": "expo-router/entry",
  "expo": {
    "autolinking": {
      "android": {
        "buildFromSource": [
          "expo-audio"
        ]
      },
      "ios": {
        "buildFromSource": [
          "expo-audio"
        ]
      }
    }
  },
  "scripts": {
    "build": "pnpm run config:check && pnpm run native:check && expo export --platform android --output-dir dist/android && expo export --platform ios --output-dir dist/ios",
    "config:check": "node scripts/check-native-config.mjs",
    "dev": "expo start",
    "doctor": "expo-doctor",
    "lint": "eslint .",
    "native:check": "node scripts/check-native-patch.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@expo-google-fonts/noto-sans-thai": "0.4.2",
    "@expo/metro-runtime": "57.0.8",
    "@supabase/supabase-js": "2.111.0",
    "@thainaute/analytics": "workspace:*",
    "@thainaute/content": "workspace:*",
    "@thainaute/design-tokens": "workspace:*",
    "@thainaute/domain": "workspace:*",
    "@thainaute/sync": "workspace:*",
    "expo": "57.0.9",
    "expo-asset": "57.0.8",
    "expo-audio": "57.0.3",
    "expo-constants": "57.0.8",
    "expo-crypto": "57.0.1",
    "expo-file-system": "57.0.1",
    "expo-font": "57.0.1",
    "expo-linking": "57.0.4",
    "expo-router": "57.0.9",
    "expo-secure-store": "57.0.1",
    "expo-sharing": "57.0.8",
    "expo-sqlite": "57.0.1",
    "expo-status-bar": "57.0.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-native": "0.86.2",
    "react-native-safe-area-context": "5.8.0",
    "react-native-screens": "4.26.2",
    "react-native-url-polyfill": "4.0.0",
    "react-native-worklets": "0.11.3"
  },
  "devDependencies": {
    "@testing-library/react": "16.3.2",
    "@types/react": "19.2.18",
    "eslint-config-expo": "57.0.1",
    "expo-doctor": "1.20.1",
    "jsdom": "30.0.1",
    "typescript": "6.0.3",
    "vitest": "4.1.10"
  }
}
