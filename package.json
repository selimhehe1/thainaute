{
  "name": "thainaute",
  "version": "0.0.0",
  "private": true,
  "license": "UNLICENSED",
  "packageManager": "pnpm@11.18.0",
  "engines": {
    "node": ">=24.0.0 <25.0.0",
    "pnpm": "11.18.0"
  },
  "scripts": {
    "audit:prod": "pnpm audit --prod --audit-level high",
    "build": "turbo run build",
    "dev": "turbo run dev",
    "dev:mobile": "pnpm --filter @thainaute/mobile dev",
    "dev:web": "pnpm --filter @thainaute/web dev",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "content:validate": "pnpm --filter @thainaute/content content:validate",
    "content:audit": "pnpm --filter @thainaute/content content:audit",
    "db:test": "supabase test db --local",
    "db:lint": "supabase db lint --local --level warning --fail-on error",
    "db:reset": "supabase db reset --local",
    "test:e2e:web": "pnpm --filter @thainaute/web test:e2e",
    "test:e2e:mobile": "maestro test apps/mobile/maestro",
    "generate:test-audio": "node scripts/generate-test-audio.mjs"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@types/node": "24.13.3",
    "eslint": "9.39.5",
    "prettier": "3.9.6",
    "supabase": "2.111.0",
    "turbo": "2.10.7",
    "tsx": "4.23.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.65.0",
    "vitest": "4.1.10"
  }
}
