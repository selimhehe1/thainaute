{
  "name": "thainaute",
  "version": "0.0.0",
  "private": true,
  "license": "UNLICENSED",
  "packageManager": "pnpm@11.18.0",
  "engines": {
    "node": ">=24.0.0 <25.0.0",
    "pnpm": "11.18.0"
  },
  "scripts": {
    "audit:prod": "pnpm audit --prod --audit-level high",
    "build": "turbo run build",
    "dev": "turbo run dev",
    "dev:mobile": "pnpm --filter @thainaute/mobile dev",
    "dev:web": "pnpm --filter @thainaute/web dev",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "content:validate": "pnpm --filter @thainaute/content content:validate",
    "content:audit": "pnpm --filter @thainaute/content content:audit",
    "db:test": "supabase test db --local",
    "db:lint": "supabase db lint --local --level warning --fail-on error",
    "db:advisors:security": "supabase db advisors --local --type security --level warn --fail-on warn",
    "db:advisors:performance": "supabase db advisors --local --type performance --level info --fail-on none",
    "db:reset": "supabase db reset --local",
    "test:e2e:web": "pnpm --filter @thainaute/web test:e2e",
    "test:e2e:web:connected": "pnpm --filter @thainaute/web exec playwright test e2e/connected-sync.spec.ts --project=chromium --workers=1 --retries=0 --trace=off",
    "test:e2e:web:connected:ui": "pnpm --filter @thainaute/web exec playwright test e2e/connected-learning-ui.spec.ts --project=chromium --workers=1 --retries=0 --trace=off",
    "test:e2e:web:connected:reports": "pnpm --filter @thainaute/web exec playwright test e2e/connected-content-report.spec.ts --project=chromium --workers=1 --retries=0 --trace=off",
    "test:e2e:mobile": "maestro test apps/mobile/maestro",
    "generate:test-audio": "node scripts/generate-test-audio.mjs",
    "fixture:bootstrap-local-audio": "pnpm --filter @thainaute/web exec tsx scripts/bootstrap-local-content-audio.ts"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@types/node": "24.13.3",
    "eslint": "9.39.5",
    "prettier": "3.9.6",
    "supabase": "2.111.0",
    "turbo": "2.10.8",
    "tsx": "4.23.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.66.0",
    "vitest": "4.1.10"
  }
}
