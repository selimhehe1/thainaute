  "exercises": [
    {
      "poolId": "u01-l1a-p1",
      "drawIndex": 1,
      "id": "56661afb-1a24-5e0f-83c2-0b744f983903",
      "type": "audio_choice",
      "itemId": "5e991a34-2a7e-5c52-beb1-726b83a281e3",
      "skill": "listening",
      "audioAssetId": "a6344f49-bc07-5123-8493-aa0a5e92f90f",
      "promptFr": "Vous n'entendrez que deux mots, plusieurs fois chacun. C'est voulu : le but n'est pas de les retenir, mais d'entendre que la voix part dans deux directions opposées. Elle tombe, ou elle grimpe ?",
      "options": [
        {
          "id": "d00ce2d7-fb11-537a-9b2f-251e3c17e2c9",
          "labelFr": "la voix tombe",
          "thaiRaw": null,
          "transcription": null
        },
        {
          "id": "b78d3b37-8017-5166-a2d5-58d53b271868",
          "labelFr": "la voix grimpe",
          "thaiRaw": null,
          "transcription": null
        }
      ],
      "correctOptionId": "d00ce2d7-fb11-537a-9b2f-251e3c17e2c9",
      "feedback": {
        "correctFr": "Oui. ค่า (khâa) : la voix tombe. Votre oreille vient de faire le travail.",
        "incorrectFr": "Réécoutez, et ne vous occupez que d'une chose : le début et la fin. Si la voix finit plus bas qu'elle n'a commencé, elle tombe. Si elle finit plus haut, elle grimpe.",
        "variants": []
      }
    },
